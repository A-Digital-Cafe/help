#!/usr/bin/env bash
# Sincroniza LEGAL_DOCUMENTS.*.contentHash (repo raíz de ADC-platform) con los documentos
# legales de este preset, y bloquea el commit si el texto cambió sin bump de versión.
#
# - El hash se AUTO-CORRIGE: se recalcula sobre el contenido staged y se escribe en
#   src/common/utils/legal-docs.ts del repo raíz (queda para commitear allá).
# - La versión NO se auto-bumpea: subirla dispara el aviso legal a usuarios y el ciclo de
#   re-aceptación con 30 días de preaviso, y eso es una decisión humana. Si el cambio es un
#   refactor sin cambio de texto legal: LEGAL_SKIP_VERSION_CHECK=1 git commit ...
set -euo pipefail

LEGAL_DOCS="../../src/common/utils/legal-docs.ts"
[ -f "$LEGAL_DOCS" ] || exit 0 # clon standalone, sin repo raíz: nada que sincronizar

today=$(date +%F)
blocked=0

check_doc() {
	local id="$1" f="$2"
	git diff --cached --quiet -- "$f" 2>/dev/null && return 0

	local hash current version
	hash=$(git show ":$f" | sha256sum | cut -d' ' -f1)
	current=$(perl -0ne 'print $1 if m{// sha256sum presets/help/'"$f"'\s*\n\s*contentHash: "([0-9a-f]{64})"}' "$LEGAL_DOCS")
	[ "$hash" = "$current" ] && return 0

	perl -0pi -e 's{(// sha256sum presets/help/'"$f"'\s*\n\s*contentHash: ")[0-9a-f]{64}}{${1}'"$hash"'}' "$LEGAL_DOCS"
	echo "pre-commit: contentHash de \"$id\" regenerado en src/common/utils/legal-docs.ts (repo raíz). Commitealo allá."
	# El PDF congelado NO se commitea (lleva horneados nombre legal, CUIT y domicilio: por eso
	# `apps/help/public/legal/` está en .gitignore). Se genera en el despliegue, y el de una
	# versión ya publicada nunca se regenera — de ahí el recordatorio en vez de un chequeo.
	echo "  · Tras el bump: 'bun run build:legal' genera el PDF de la versión nueva. El de la anterior vive SÓLO en el despliegue: no lo borres."

	version=$(perl -0ne 'print $1 if m{id: "'"$id"'",.*?version: "([\d-]+)"}s' "$LEGAL_DOCS")
	if [ "$version" != "$today" ] && [ "${LEGAL_SKIP_VERSION_CHECK:-0}" != "1" ]; then
		echo "pre-commit: BLOQUEADO — \"$id\" cambió pero su version en legal-docs.ts es $version (hoy: $today)."
		echo "  · Si cambió el texto legal: bump de version a $today y effectiveFrom a +30 días en legal-docs.ts."
		echo "  · Si es un refactor sin cambio de texto: LEGAL_SKIP_VERSION_CHECK=1 git commit ..."
		blocked=1
	fi
}

check_doc terms apps/help/src/pages/TermsPage.tsx
check_doc privacy apps/help/src/pages/PrivacyPage.tsx

exit $blocked
