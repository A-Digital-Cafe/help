{
	"name": "LegalDocsService",
	"uiName": "Ayuda",
	"version": "1.0.0",
	"kernelMode": 62,
	"failOnError": false,
	"privileges": ["identity:internal", "notifications:broadcast", "audit:write"],
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-replicaSet=rs0&authSource=admin}",
				"db": "adc-legal"
			}
		},
		{
			"name": "queue/redis",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${REDIS_HOST:-localhost}",
				"port": "${REDIS_PORT:-6380}",
				"password": "${REDIS_PASSWORD}",
				"db": 0,
				"keyPrefix": "adc:legal:"
			}
		}
	],
	"services": [
		{
			"name": "EndpointManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "IdentityManagerService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "AuditLogService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "OperationsService",
			"version": "latest",
			"optional": true
		}
	],
	"private": {
		"runsRetentionDays": "${LEGAL_RUNS_RETENTION_DAYS:-1825}"
	}
}
